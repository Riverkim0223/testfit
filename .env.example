# 로컬 개발
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Vercel Production 예시
# NEXT_PUBLIC_SITE_URL=https://testfit-black.vercel.app

# 로컬에서 next start 환경에서도 Studio를 강제로 켤 때만 사용합니다.
# Vercel에서는 이 값과 무관하게 Studio가 비활성화됩니다.
# TEST_STUDIO_ENABLED=true

# 선택 사항: 재배포 권한이 있는 한국어 WOFF/WOFF2 폰트 URL
# TEST_FACTORY_SHARE_FONT_URL=/fonts/your-korean-font-bold.woff2
